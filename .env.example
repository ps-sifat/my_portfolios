# Copy this file to `.env` (never commit `.env`) and fill in your EmailJS keys.
# Get them from https://dashboard.emailjs.com → Email Services / Email Templates / Account.
# On Vercel add the same three names under Project → Settings → Environment Variables.
# If these are empty, the contact form falls back to opening the visitor's mail app.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
